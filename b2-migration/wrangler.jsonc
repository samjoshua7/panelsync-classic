  "main": "worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "MediaQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaQuota"] }],
