    "B2_BUCKET_NAME": "panelsync-bucket",
    "B2_BUCKET_ID": "f2e3ee572ef0891fa9100a16",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5501,http://localhost:5501,https://samjoshua7.github.io",
    "ALLOW_LOCALHOST": "true",
    "STORAGE_LIMIT_BYTES": "1000000000",
    "MAX_FILE_BYTES": "83886080"
  },
  "observability": { "enabled": false }
}
